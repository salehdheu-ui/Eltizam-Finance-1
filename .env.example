# --- Required ---
DATABASE_URL=postgres://user:password@localhost:5432/eltizam
SESSION_SECRET=replace-with-a-strong-random-secret
APP_BASE_URL=http://localhost:5000

# Public URL used to build OAuth redirect URIs behind a proxy.
PUBLIC_APP_URL=http://localhost:5000

# Key used to encrypt stored OAuth tokens and admin-managed client secrets.
# Falls back to SESSION_SECRET when unset — set it explicitly in production.
TOKEN_ENCRYPTION_KEY=replace-with-a-second-strong-random-secret

# --- Email (password reset notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_AUTH=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Eltizam <your-email@example.com>"

# --- Bank email inbox (optional) ---
# These are only a fallback. A system admin can set the same credentials from
# the admin panel (تكامل البريد), where they are stored encrypted in the database
# and take precedence over the values below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# Minutes between automatic bank inbox syncs (clamped to 2–60).
BANK_EMAIL_SYNC_MINUTES=5

# --- Notifications (optional) ---
# Web Push. Generate a pair once and keep it stable — changing it invalidates
# every device subscription already handed out.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Telegram: create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API: needs a Meta Business account and a verified number.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Minutes between automation passes (clamped to 5-360).
AUTOMATION_INTERVAL_MINUTES=30
